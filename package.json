{
  "name": "empire-of-the-light",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs && node scripts/validate-monorepo.mjs",
    "module:test": "node --test packages/module-kit/test/*.test.mjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/validate.mjs && node scripts/validate-monorepo.mjs && node --test packages/module-kit/test/*.test.mjs",
    "db:generate": "pnpm --filter @empire/db db:generate",
    "db:migrate": "pnpm --filter @empire/db db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
